{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [
    "${mod_authors}"
  ],
  "contributors": [
    "Suiyun"
  ],
  "contact": {
    "homepage": "${mod_page}",
    "sources": "${mod_github}"
  },
  "license": "${mod_license}",
  "icon": "icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "io.github.mortuusars.exposure_polaroid.fabric.ExposurePolaroidFabric"
    ],
    "client": [
      "io.github.mortuusars.exposure_polaroid.fabric.ExposurePolaroidFabricClient"
    ]
  },
  "mixins": [
    "exposure_polaroid-fabric.mixins.json",
    "exposure_polaroid-common.mixins.json"
  ],
  "accessWidener": "exposure_polaroid.accesswidener",
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": "~${minecraft_version}",
    "java": ">=25",
    "fabric-api": "*",
    "forgeconfigapiport": ">=21.0.0",
    "exposure": "${required_exposure_version_range_fabric}"
  }
}
